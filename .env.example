NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/taskdesk
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# Seed script (Super Admin login)
SEED_ADMIN_NAME=Platform Owner
SEED_ADMIN_EMAIL=admin@taskdesk.local
SEED_ADMIN_PASSWORD=ChangeMe123!
# Set to false to disable the daily reminder job
ENABLE_CRON=true

# Browser notifications (web push). Generate keys with:  npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Secret for the external scheduler that calls /api/cron/run (use a long random string)
CRON_SECRET=

# Email (password reset + security alerts). Use ONE provider. See README.
EMAIL_PROVIDER=resend
EMAIL_FROM=Taxkflow <onboarding@resend.dev>
RESEND_API_KEY=
BREVO_API_KEY=
APP_NAME=Taxkflow

# Receipt storage (optional). Without it, receipts are stored in MongoDB. Get this from your Cloudinary dashboard. KEEP SECRET.
# Paystack (online payments). Use your TEST secret key (sk_test_...) first, the LIVE key (sk_live_...) when you are ready. KEEP SECRET.
PAYSTACK_SECRET_KEY=

CLOUDINARY_URL=

# AI connection (optional). Any OpenAI-compatible provider. Leave empty to run without AI.
# Examples: Groq  https://api.groq.com/openai/v1 | OpenRouter  https://openrouter.ai/api/v1 | local Ollama  http://localhost:11434/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Safety limits (defaults shown)
AI_TIMEOUT_MS=12000
AI_MAX_CONCURRENT=4
AI_MAX_QUEUE=8
# Set to false to switch every AI feature off without redeploying code
AI_ENABLED=true
# Plan my day limits (per user per day, and across all users per day). Keep the global one under your provider's free allowance.
AI_DAILY_LIMIT_PERSONAL=5
AI_DAILY_LIMIT_BUSINESS=10
AI_GLOBAL_DAILY_LIMIT=120
# Reuse the Plan my day suggestion for this many minutes when the tasks have not changed (0 = off)
AI_PLAN_CACHE_MINUTES=15

# Automatic cleanup of old data (days; 0 = never delete that kind). Checked every few hours.
NOTIFICATION_READ_DAYS=30
NOTIFICATION_MAX_DAYS=90
INVITATION_DAYS=90
# Off by default: the activity log is your audit trail. Set e.g. 365 to keep only the last year.
ACTIVITY_RETENTION_DAYS=0
# Optional: low | medium | high | none. Reasoning models (gpt-oss) default to low.
AI_REASONING_EFFORT=
# Optional: dedicated key for encrypting 2FA secrets (falls back to JWT_SECRET). Set once and never change it.
TWO_FA_ENCRYPTION_KEY=
SERVE_CLIENT=false
