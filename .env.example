NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/taskdesk
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# Seed script (Super Admin login)
SEED_ADMIN_NAME=Platform Owner
SEED_ADMIN_EMAIL=admin@taskdesk.local
SEED_ADMIN_PASSWORD=ChangeMe123!
# Set to false to disable the daily reminder job
ENABLE_CRON=true

# Browser notifications (web push). Generate keys with:  npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Secret for the external scheduler that calls /api/cron/run (use a long random string)
CRON_SECRET=
SERVE_CLIENT=false
